# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- Artifact access -------------------------------------------------------
# Read-only, scoped, expiring token for the edge-agent build. Sent to you
# separately through a secure channel — it is deliberately not in this repo.
# It can read one repository and nothing else. If it has expired, ask for a
# new one rather than a broader one.
JFROG_TOKEN=REPLACE_ME
JFROG_URL=https://insightsoftmax.jfrog.io
JFROG_REPO=nokia-eda-demo

# ---- Palette ---------------------------------------------------------------
PALETTE_ENDPOINT=https://your-palette-instance.example.com
PALETTE_API_KEY=REPLACE_ME
PALETTE_PROJECT_UID=REPLACE_ME
PALETTE_PROJECT_NAME=Default
EDGE_REGISTRATION_TOKEN=REPLACE_ME
CLUSTER_PROFILE_UID=REPLACE_ME
# Comma-separated profile variables, if your profile needs them:
# PROFILE_VARIABLES=baseDomain=demo.local,argocdAdminPasswordPlain=ChangeMe
PROFILE_VARIABLES=

# ---- Fabric / host ---------------------------------------------------------
# The fabric node name must match the remote.node on the edge TopoLink that
# names this host — that mapping is how the provider finds the leaf port.
EDA_FABRIC_NODE=lab-gpu-01
EDGE_HOST_NAME=lab-gpu-01
EDA_KUBECONFIG=/absolute/path/to/eda.kubeconfig

# ---- Tenant network --------------------------------------------------------
# The control-plane VIP MUST sit inside the tenant subnet. The agent
# fail-closes otherwise: "invalid vip ... is not in the CIDR ...".
NET_ISO_INTERFACE=enp2s0
NET_ISO_VLAN=310
NET_ISO_SUBNET_IPV4=10.210.0.50
NET_ISO_SUBNET_PREFIX=24
CONTROL_PLANE_VIP=10.210.0.100

# ---- Local VM --------------------------------------------------------------
VM_NAME=eda-edge-01
VM_MEMORY_MB=8192
VM_VCPUS=4
VM_DISK_GB=40
VM_USER=demo
VM_PASSWORD=demo
LIBVIRT_NETWORK=default
# libvirt connection. qemu:///system is required: session mode has no networks of
# its own, so --network network=default does not exist there, and
# /var/lib/libvirt/images is root-owned. Building the VM therefore needs sudo.
LIBVIRT_URI=qemu:///system
